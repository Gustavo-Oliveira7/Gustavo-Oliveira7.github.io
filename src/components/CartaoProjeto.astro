---
import type { Repo } from '../lib/github';
import { formatarData } from '../lib/github';
import { pegarCorLinguagem } from '../lib/texto';
import Icone from './Icone.astro';

interface Props {
  repo: Repo;
  /** Sobrescreve a descricao vinda do GitHub */
  descricao?: string;
  tags?: string[];
}

const { repo, descricao, tags } = Astro.props;
const texto = descricao ?? repo.descricao ?? 'Sem descricao no repositorio.';
const badges = tags ?? repo.topicos.slice(0, 3);
---

{/*
  Os atributos data-* permitem que o script de /projetos atualize
  estrelas, forks e data no navegador, sem esperar um novo build.
*/}
<article class="cartao projeto" data-repo={repo.nome} data-linguagem={repo.linguagem ?? 'Outros'}>
  <div class="projeto__topo">
    <h3 class="projeto__nome">
      <a href={repo.url} target="_blank" rel="noopener">
        {repo.nome}
        <span class="projeto__seta"><Icone nome="seta" tamanho={15} /></span>
      </a>
    </h3>
    {
      repo.homepage && (
        <a
          href={repo.homepage}
          target="_blank"
          rel="noopener"
          class="projeto__demo"
          aria-label="Abrir demo do projeto"
        >
          <Icone nome="link" tamanho={15} />
        </a>
      )
    }
  </div>

  <p class="projeto__desc suave">{texto}</p>

  {
    badges.length > 0 && (
      <div class="linha wrap gap-sm">
        {badges.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }

  <div class="projeto__meta mt-auto">
    <span class="projeto__item" data-campo="linguagem" hidden={!repo.linguagem}>
      <span class="ponto" style={`background:${pegarCorLinguagem(repo.linguagem)}`}></span>
      <span data-valor="linguagem">{repo.linguagem}</span>
    </span>

    <span class="projeto__item" data-campo="estrelas" hidden={repo.estrelas === 0}>
      <Icone nome="estrela" tamanho={13} />
      <span data-valor="estrelas">{repo.estrelas}</span>
    </span>

    <span class="projeto__item" data-campo="forks" hidden={repo.forks === 0}>
      <Icone nome="fork" tamanho={13} />
      <span data-valor="forks">{repo.forks}</span>
    </span>

    <span class="projeto__item projeto__data" title="Ultimo push neste repositorio">
      <span data-valor="atualizado">{formatarData(repo.atualizadoEm)}</span>
    </span>
  </div>
</article>

<style>
  .projeto__topo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .projeto__nome {
    font-family: var(--fonte-mono);
    font-size: var(--t-base);
    font-weight: 550;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .projeto__nome a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color var(--transicao);
  }
  .projeto__nome a:hover { color: var(--acento); }

  .projeto__seta {
    color: var(--texto-fraco);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity var(--transicao), transform var(--transicao);
  }
  .cartao:hover .projeto__seta {
    opacity: 1;
    transform: translateX(0);
  }

  .projeto__demo {
    color: var(--texto-fraco);
    transition: color var(--transicao);
    flex-shrink: 0;
  }
  .projeto__demo:hover { color: var(--acento); }

  .projeto__desc {
    font-size: var(--t-sm);
    line-height: 1.6;
  }

  .projeto__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    font-size: var(--t-xs);
    color: var(--texto-fraco);
  }

  .projeto__item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .projeto__item[hidden] { display: none; }

  .projeto__data { margin-left: auto; }

  .ponto {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
</style>

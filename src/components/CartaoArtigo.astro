---
import { dataCurta } from '../lib/texto';
import Icone from './Icone.astro';

interface Props {
  slug: string;
  titulo: string;
  resumo: string;
  data: Date;
  tags: string[];
  minutos: number;
  /** Layout compacto usado na home */
  compacto?: boolean;
}

const { slug, titulo, resumo, data, tags, minutos, compacto = false } = Astro.props;
---

<article class:list={['artigo-cartao', { 'artigo-cartao--compacto': compacto }]}>
  <a href={`/artigos/${slug}`} class="artigo-cartao__link">
    <div class="artigo-cartao__meta">
      <time datetime={data.toISOString()}>{dataCurta(data)}</time>
      <span class="artigo-cartao__sep">·</span>
      <span class="linha gap-sm">
        <Icone nome="relogio" tamanho={13} />
        {minutos} min
      </span>
    </div>

    <h3 class="artigo-cartao__titulo">{titulo}</h3>
    <p class="artigo-cartao__resumo suave">{resumo}</p>

    {
      tags.length > 0 && !compacto && (
        <div class="linha wrap gap-sm artigo-cartao__tags">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }

    <span class="link-acento artigo-cartao__cta">
      Ler artigo <Icone nome="seta" tamanho={15} />
    </span>
  </a>
</article>

<style>
  .artigo-cartao {
    border-bottom: 1px solid var(--border);
  }
  .artigo-cartao:last-child { border-bottom: none; }

  .artigo-cartao__link {
    display: block;
    padding-block: 1.75rem;
    transition: transform var(--transicao);
  }
  .artigo-cartao__link:hover { transform: translateX(3px); }

  .artigo-cartao__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--fonte-mono);
    font-size: var(--t-xs);
    color: var(--texto-fraco);
    margin-bottom: 0.6rem;
  }

  .artigo-cartao__sep { opacity: 0.5; }

  .artigo-cartao__titulo {
    font-size: var(--t-xl);
    margin-bottom: 0.5rem;
    transition: color var(--transicao);
  }
  .artigo-cartao__link:hover .artigo-cartao__titulo { color: var(--acento); }

  .artigo-cartao__resumo {
    font-size: var(--t-sm);
    line-height: 1.65;
    max-width: 46rem;
  }

  .artigo-cartao__tags { margin-top: 0.9rem; }

  .artigo-cartao__cta {
    font-size: var(--t-sm);
    margin-top: 0.9rem;
  }

  .artigo-cartao--compacto .artigo-cartao__link { padding-block: 1.25rem; }
  .artigo-cartao--compacto .artigo-cartao__titulo { font-size: var(--t-lg); }
  .artigo-cartao--compacto .artigo-cartao__cta { display: none; }
</style>

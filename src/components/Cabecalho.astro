---
import { site, links, navegacao } from '../site.config';
import Icone from './Icone.astro';

const atual = Astro.url.pathname;
const ehAtual = (href: string) =>
  href === '/' ? atual === '/' : atual.startsWith(href);
---

<header class="cabecalho">
  <div class="container cabecalho__interno">
    <a href="/" class="marca" aria-label="Ir para a pagina inicial">
      <span class="marca__sigla">gu</span>
      <span class="marca__nome">{site.nome}</span>
    </a>

    <nav class="nav" aria-label="Navegacao principal">
      {
        navegacao.map((item) => (
          <a
            href={item.href}
            class:list={['nav__link', { 'nav__link--atual': ehAtual(item.href) }]}
            aria-current={ehAtual(item.href) ? 'page' : undefined}
          >
            {item.rotulo}
          </a>
        ))
      }
    </nav>

    <div class="cabecalho__acoes">
      <a href={links.github} target="_blank" rel="noopener" class="icone-link" aria-label="GitHub">
        <Icone nome="github" tamanho={18} />
      </a>
      <a href={links.linkedin} target="_blank" rel="noopener" class="icone-link" aria-label="LinkedIn">
        <Icone nome="linkedin" tamanho={17} />
      </a>
      <button type="button" class="icone-link" id="alternar-tema" aria-label="Alternar tema claro e escuro">
        <span class="so-escuro"><Icone nome="sol" tamanho={18} /></span>
        <span class="so-claro"><Icone nome="lua" tamanho={18} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .cabecalho__interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .marca__sigla {
    font-family: var(--fonte-mono);
    color: var(--acento);
    background: var(--acento-suave);
    border: 1px solid color-mix(in srgb, var(--acento) 30%, transparent);
    border-radius: var(--raio-sm);
    padding: 0.15rem 0.45rem;
    font-size: var(--t-sm);
  }

  .marca__nome {
    font-size: var(--t-sm);
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    padding: 0.4rem 0.75rem;
    border-radius: var(--raio-sm);
    font-size: var(--t-sm);
    color: var(--texto-suave);
    transition: color var(--transicao), background var(--transicao);
  }
  .nav__link:hover {
    color: var(--texto);
    background: var(--surface);
  }
  .nav__link--atual {
    color: var(--acento);
    background: var(--acento-suave);
  }

  .cabecalho__acoes {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .icone-link {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: var(--raio-sm);
    border: none;
    background: none;
    color: var(--texto-suave);
    transition: color var(--transicao), background var(--transicao);
  }
  .icone-link:hover {
    color: var(--acento);
    background: var(--surface);
  }

  /* O toggle mostra o icone do tema para o qual voce vai trocar. */
  :global(:root[data-tema='claro']) .so-escuro { display: none; }
  :global(:root:not([data-tema='claro'])) .so-claro { display: none; }

  @media (max-width: 42rem) {
    .marca__nome { display: none; }
    .nav__link { padding-inline: 0.5rem; }
  }

  @media (max-width: 30rem) {
    .cabecalho__acoes a { display: none; }
  }
</style>

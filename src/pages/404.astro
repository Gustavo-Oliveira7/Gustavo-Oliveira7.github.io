---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This route does not exist.">
  <section class="block missing">
    <p class="tag">404</p>
    <h1 class="statement missing__title">This route does not exist.</h1>
    <p class="lede missing__text">
      The address does not match any page on this site. The link may be out of date, or have a typo
      in it.
    </p>
    <div class="rowf wrap g-sm">
      <a href="/" class="frame-btn frame-btn--fill">Home</a>
      <a href="/writing" class="frame-btn">Writing</a>
      <a href="/work" class="frame-btn">Work</a>
    </div>
  </section>
</Base>

<style>
  .missing { max-width: 34rem; padding-top: 3rem; }
  .missing__title { margin: 1rem 0; }
  .missing__text { margin-bottom: 2rem; }
</style>

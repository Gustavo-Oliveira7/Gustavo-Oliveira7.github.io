---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { dataLonga, tempoLeitura } from '../../lib/texto';
import { links, site } from '../../site.config';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const artigos = await getCollection('artigos', ({ data }) => !data.rascunho);
  const ordenados = artigos.sort((a, b) => +b.data.data - +a.data.data);

  return ordenados.map((artigo, i) => ({
    params: { slug: artigo.id },
    props: {
      artigo,
      // Navegacao entre artigos no rodape do texto
      anterior: ordenados[i + 1] ?? null,
      proximo: ordenados[i - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { artigo, anterior, proximo } = Astro.props;
const { Content } = await render(artigo);
const minutos = tempoLeitura(artigo.body ?? '');

const urlCompartilhar = new URL(Astro.url.pathname, Astro.site).toString();
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(urlCompartilhar)}`;
---

<Base
  titulo={artigo.data.titulo}
  descricao={artigo.data.resumo}
  tipo="article"
  publicadoEm={artigo.data.data}
>
  <article class="container artigo">
    <a href="/artigos" class="voltar">
      <span class="voltar__seta">←</span> Todos os artigos
    </a>

    <header class="artigo__cabecalho">
      <div class="artigo__meta mono">
        <time datetime={artigo.data.data.toISOString()}>{dataLonga(artigo.data.data)}</time>
        <span class="artigo__sep">·</span>
        <span class="linha gap-sm">
          <Icone nome="relogio" tamanho={13} />
          {minutos} min de leitura
        </span>
      </div>

      <h1 class="artigo__titulo">{artigo.data.titulo}</h1>
      <p class="artigo__resumo">{artigo.data.resumo}</p>

      {
        artigo.data.tags.length > 0 && (
          <div class="linha wrap gap-sm artigo__tags">
            {artigo.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prosa">
      <Content />
    </div>

    <footer class="artigo__rodape">
      <div class="compartilhar">
        <p class="fraco">Achou util? Compartilhe:</p>
        <div class="linha wrap gap-sm">
          <a href={linkedinShare} target="_blank" rel="noopener" class="botao">
            <Icone nome="linkedin" tamanho={15} /> LinkedIn
          </a>
          <button type="button" class="botao" id="copiar-link">
            <Icone nome="link" tamanho={15} /> <span id="copiar-texto">Copiar link</span>
          </button>
        </div>
      </div>

      <div class="autor">
        <p class="autor__nome">{site.nome}</p>
        <p class="fraco">{site.cargo}</p>
        <div class="linha wrap gap-sm autor__links">
          <a href={links.github} target="_blank" rel="noopener" class="link-acento">
            <Icone nome="github" tamanho={15} /> GitHub
          </a>
          <a href={links.linkedin} target="_blank" rel="noopener" class="link-acento">
            <Icone nome="linkedin" tamanho={14} /> LinkedIn
          </a>
        </div>
      </div>
    </footer>

    {
      (anterior || proximo) && (
        <nav class="vizinhos" aria-label="Outros artigos">
          {anterior ? (
            <a href={`/artigos/${anterior.id}`} class="vizinho">
              <span class="fraco mono">← Anterior</span>
              <span class="vizinho__titulo">{anterior.data.titulo}</span>
            </a>
          ) : (
            <span />
          )}
          {proximo && (
            <a href={`/artigos/${proximo.id}`} class="vizinho vizinho--direita">
              <span class="fraco mono">Proximo →</span>
              <span class="vizinho__titulo">{proximo.data.titulo}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<script>
  document.getElementById('copiar-link')?.addEventListener('click', async () => {
    const rotulo = document.getElementById('copiar-texto');
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (rotulo) {
        rotulo.textContent = 'Link copiado!';
        setTimeout(() => (rotulo.textContent = 'Copiar link'), 2000);
      }
    } catch {
      if (rotulo) rotulo.textContent = 'Nao foi possivel copiar';
    }
  });
</script>

<style>
  .artigo {
    padding-block: 3rem 2rem;
    max-width: calc(var(--largura-texto) + 3rem);
  }

  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--texto-fraco);
    transition: color var(--transicao), gap var(--transicao);
    margin-bottom: 2.5rem;
  }
  .voltar:hover {
    color: var(--acento);
    gap: 0.7rem;
  }

  .artigo__cabecalho {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .artigo__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-xs);
    color: var(--texto-fraco);
    margin-bottom: 1rem;
  }
  .artigo__sep { opacity: 0.5; }

  .artigo__titulo {
    font-size: clamp(1.9rem, 4.5vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .artigo__resumo {
    font-size: var(--t-lg);
    color: var(--texto-suave);
    line-height: 1.6;
  }

  .artigo__tags { margin-top: 1.5rem; }

  .artigo__rodape {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .compartilhar p { margin-bottom: 0.7rem; }

  .autor {
    text-align: right;
  }
  .autor__nome { font-weight: 600; }
  .autor__links {
    justify-content: flex-end;
    margin-top: 0.6rem;
    font-size: var(--t-sm);
  }

  .vizinhos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  .vizinho {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--raio);
    background: var(--surface);
    transition: border-color var(--transicao), transform var(--transicao);
  }
  .vizinho:hover {
    border-color: var(--acento);
    transform: translateY(-2px);
  }
  .vizinho--direita { text-align: right; }

  .vizinho__titulo {
    font-size: var(--t-sm);
    font-weight: 550;
    line-height: 1.4;
  }

  @media (max-width: 40rem) {
    .autor { text-align: left; }
    .autor__links { justify-content: flex-start; }
    .vizinhos { grid-template-columns: 1fr; }
    .vizinho--direita { text-align: left; }
  }
</style>

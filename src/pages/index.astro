---
import Base from '../layouts/Base.astro';
import CartaoProjeto from '../components/CartaoProjeto.astro';
import CartaoArtigo from '../components/CartaoArtigo.astro';
import Icone from '../components/Icone.astro';
import { site, links, stack, projetosDestaque } from '../site.config';
import { buscarRepositorios, buscarPerfil } from '../lib/github';
import { tempoLeitura } from '../lib/texto';
import { getCollection } from 'astro:content';

// Dados do GitHub buscados no build. Ver src/lib/github.ts.
const repos = await buscarRepositorios();
const perfil = await buscarPerfil();

// Casa a lista de destaques do site.config com os dados reais do GitHub.
const destaques = projetosDestaque
  .map((d) => {
    const repo = repos.find((r) => r.nome.toLowerCase() === d.repo.toLowerCase());
    return repo ? { repo, descricao: d.descricao, tags: d.tags } : null;
  })
  .filter((x) => x !== null);

// Se a API do GitHub estiver fora, cai para os repos mais recentes.
const projetos = destaques.length > 0 ? destaques : repos.slice(0, 3).map((repo) => ({ repo, descricao: undefined, tags: undefined }));

const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho))
  .sort((a, b) => +b.data.data - +a.data.data)
  .slice(0, 3);
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="container hero">
    <p class="hero__rotulo mono">{site.cargo} · Java &amp; Go</p>
    <h1 class="hero__titulo">{site.nome}</h1>

    <div class="hero__bio">
      {site.bio.map((p) => <p>{p}</p>)}
    </div>

    <div class="hero__acoes">
      <a href="/projetos" class="botao botao--primario">
        Ver projetos <Icone nome="seta" tamanho={16} />
      </a>
      <a href="/artigos" class="botao">Ler artigos</a>
      <a href={links.github} target="_blank" rel="noopener" class="botao">
        <Icone nome="github" tamanho={16} /> GitHub
      </a>
      <a href={links.linkedin} target="_blank" rel="noopener" class="botao">
        <Icone nome="linkedin" tamanho={15} /> LinkedIn
      </a>
    </div>

    {
      perfil && (
        <p class="hero__stats mono fraco">
          {perfil.reposPublicos} repositorios publicos · {perfil.seguidores} seguidores no GitHub
        </p>
      )
    }
  </section>

  <!-- ============ STACK ============ -->
  <section class="container secao--compacta">
    <div class="stack">
      {
        stack.map((grupo) => (
          <div class="stack__grupo">
            <p class="stack__titulo mono">{grupo.grupo}</p>
            <div class="linha wrap gap-sm">
              {grupo.itens.map((i) => (
                <span class="tag">{i}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ PROJETOS ============ -->
  <section class="container secao">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo-secao">Projetos</p>
        <h2>Em destaque</h2>
      </div>
      <a href="/projetos" class="link-acento">
        Todos os projetos <Icone nome="seta" tamanho={16} />
      </a>
    </div>

    {
      projetos.length > 0 ? (
        <div class="grade">
          {projetos.map((p) => (
            <CartaoProjeto repo={p.repo} descricao={p.descricao} tags={p.tags} />
          ))}
        </div>
      ) : (
        <p class="suave">
          Nao foi possivel carregar os repositorios agora.{' '}
          <a href={links.github} class="link-acento" target="_blank" rel="noopener">
            Ver direto no GitHub
          </a>
        </p>
      )
    }
  </section>

  <!-- ============ ARTIGOS ============ -->
  <section class="container secao">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo-secao">Escrita</p>
        <h2>Ultimos artigos</h2>
      </div>
      <a href="/artigos" class="link-acento">
        Todos os artigos <Icone nome="seta" tamanho={16} />
      </a>
    </div>

    {
      artigos.length > 0 ? (
        <div class="lista-artigos">
          {artigos.map((a) => (
            <CartaoArtigo
              slug={a.id}
              titulo={a.data.titulo}
              resumo={a.data.resumo}
              data={a.data.data}
              tags={a.data.tags}
              minutos={tempoLeitura(a.body ?? '')}
              compacto
            />
          ))}
        </div>
      ) : (
        <p class="suave">Nenhum artigo publicado ainda.</p>
      )
    }
  </section>

  <!-- ============ CONTATO ============ -->
  <section class="container secao">
    <div class="contato">
      <div>
        <p class="rotulo-secao">Contato</p>
        <h2>Vamos conversar</h2>
        <p class="suave contato__texto">
          Aberto a trocar ideia sobre backend, arquitetura ou oportunidades. A resposta mais rapida
          costuma vir pelo LinkedIn.
        </p>
      </div>
      <div class="linha wrap gap">
        <a href={`mailto:${links.email}`} class="botao botao--primario">
          <Icone nome="email" tamanho={16} /> {links.email}
        </a>
        <a href={links.linkedin} target="_blank" rel="noopener" class="botao">
          <Icone nome="linkedin" tamanho={15} /> LinkedIn
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 5.5rem 3rem;
    max-width: 52rem;
  }

  .hero__rotulo {
    color: var(--acento);
    font-size: var(--t-sm);
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .hero__titulo {
    margin-bottom: 1.5rem;
    background: linear-gradient(160deg, var(--texto) 30%, var(--texto-suave));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__bio {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: var(--t-lg);
    color: var(--texto-suave);
    max-width: 42rem;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero__stats { margin-top: 1.5rem; }

  .stack {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--raio);
  }

  .stack__titulo {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--acento);
    margin-bottom: 0.7rem;
  }

  .lista-artigos {
    border-top: 1px solid var(--border);
  }

  .contato {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding: 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--raio);
  }

  .contato__texto {
    max-width: 34rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 40rem) {
    .hero { padding-block: 3.5rem 2rem; }
    .contato { padding: 1.75rem; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import SplitSignature from '../components/SplitSignature.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import WritingEntry from '../components/WritingEntry.astro';
import Icon from '../components/Icon.astro';
import { site, links, toolkit, featuredProjects } from '../site.config';
import { fetchRepos } from '../lib/github';
import { readingTime } from '../lib/text';
import { getCollection } from 'astro:content';

const repos = await fetchRepos();

const featured = featuredProjects
  .map((f) => {
    const repo = repos.find((r) => r.name.toLowerCase() === f.repo.toLowerCase());
    return repo ? { repo, blurb: f.blurb } : null;
  })
  .filter((x) => x !== null);

// If the API was unreachable at build time, lead with the most recent repos.
const shown = featured.length > 0 ? featured : repos.slice(0, 3).map((repo) => ({ repo, blurb: undefined }));

const pieces = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
---

<Base>
  <!-- ============================ HERO ============================ -->
  <section class="block hero">
    <p class="tag">
      {site.role} <span class="hero__sep">/</span> Java and Go <span class="hero__sep">/</span>
      {site.location}
    </p>

    <h1 class="statement hero__statement">{site.statement}</h1>

    <div class="hero__signature">
      <SplitSignature />
    </div>

    <p class="hero__annotation">{site.annotation}</p>

    <p class="lede hero__intro">{site.intro}</p>

    <div class="rowf wrap g-sm hero__acts">
      <a href="/writing" class="frame-btn frame-btn--fill">Read the writing</a>
      <a href="/work" class="frame-btn">Browse the code</a>
    </div>
  </section>

  <!-- ============================ TOOLKIT ============================ -->
  <section class="block">
    <h2 class="h-section spec__heading">toolkit</h2>
    <dl class="spec">
      {
        toolkit.map((group) => (
          <div class="spec__row">
            <dt class="tag">{group.field}</dt>
            <dd class="dotted spec__values">
              {group.values.map((v) => (
                <span>{v}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ============================ WORK ============================ -->
  <section class="block">
    <div class="rowf between baseline g-sm head">
      <h2 class="h-section">selected work</h2>
      <a href="/work" class="act">
        All repositories <span class="act__arrow"><Icon name="arrow" size={13} /></span>
      </a>
    </div>

    {
      shown.length > 0 ? (
        <div class="entries">
          {shown.map((p) => (
            <ProjectEntry repo={p.repo} blurb={p.blurb} />
          ))}
        </div>
      ) : (
        <p class="body-text">
          The repository list could not be loaded during the last build.{' '}
          <a href={links.github} class="act" target="_blank" rel="noopener">
            See them on GitHub
          </a>
        </p>
      )
    }
  </section>

  <!-- ============================ WRITING ============================ -->
  <section class="block">
    <div class="rowf between baseline g-sm head">
      <h2 class="h-section">writing</h2>
      <a href="/writing" class="act">
        All pieces <span class="act__arrow"><Icon name="arrow" size={13} /></span>
      </a>
    </div>

    {
      pieces.length > 0 ? (
        <div class="entries">
          {pieces.map((p) => (
            <WritingEntry
              slug={p.id}
              title={p.data.title}
              summary={p.data.summary}
              date={p.data.date}
              tags={p.data.tags}
              minutes={readingTime(p.body ?? '')}
            />
          ))}
        </div>
      ) : (
        <p class="body-text">Nothing published yet.</p>
      )
    }
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="block">
    <h2 class="h-section head">get in touch</h2>
    <p class="lede contact__text">
      Open to talking about backend work, architecture, or a role. Email lands fastest.
    </p>
    <div class="rowf wrap g-md contact__links">
      <a href={`mailto:${links.email}`} class="act">
        <Icon name="mail" size={14} />
        {links.email}
      </a>
      <a href={links.linkedin} target="_blank" rel="noopener" class="act">
        <Icon name="linkedin" size={13} /> LinkedIn
      </a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 0.5rem; }

  .hero__sep {
    color: var(--rule-2);
    margin-inline: 0.15rem;
  }

  .hero__statement { margin: 1.1rem 0 2rem; }

  .hero__signature { max-width: 50rem; }

  .hero__annotation {
    font-family: var(--data);
    font-size: var(--t-xs);
    color: var(--ink-3);
    margin-top: 0.9rem;
    max-width: 50rem;
  }

  .hero__intro { margin-top: 2rem; }

  .hero__acts { margin-top: 1.75rem; }

  /* ---- Spec table ---- */
  .spec__heading { margin-bottom: 1.5rem; }

  .spec { border-top: 1px solid var(--rule); }

  .spec__row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .spec__values { color: var(--ink-2); }

  .head { margin-bottom: 1.5rem; }

  .contact__text { margin-bottom: 1.25rem; }

  @media (max-width: 44rem) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>

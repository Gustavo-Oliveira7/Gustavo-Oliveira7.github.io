---
import Base from '../layouts/Base.astro';
import CartaoProjeto from '../components/CartaoProjeto.astro';
import Icone from '../components/Icone.astro';
import { links, githubUser, projetosDestaque } from '../site.config';
import { buscarRepositorios, contarLinguagens } from '../lib/github';

const repos = await buscarRepositorios();
const linguagens = contarLinguagens(repos);

// Os destaques configurados sobem para o topo da lista.
const ordemDestaque = new Map(
  projetosDestaque.map((d, i) => [d.repo.toLowerCase(), i]),
);
const ordenados = [...repos].sort((a, b) => {
  const da = ordemDestaque.get(a.nome.toLowerCase()) ?? 999;
  const db = ordemDestaque.get(b.nome.toLowerCase()) ?? 999;
  if (da !== db) return da - db;
  return +new Date(b.atualizadoEm) - +new Date(a.atualizadoEm);
});

const descricaoCustom = new Map(
  projetosDestaque.filter((d) => d.descricao).map((d) => [d.repo.toLowerCase(), d.descricao!]),
);
---

<Base
  titulo="Projetos"
  descricao="Repositorios publicos, puxados direto da API do GitHub e atualizados automaticamente."
>
  <section class="container secao">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo-secao">Projetos</p>
        <h1 class="titulo-pagina">Repositorios</h1>
        <p class="suave descricao-pagina">
          Esta lista vem direto da API do GitHub — quando eu publico um repositorio novo, ele aparece
          aqui sozinho. Forks e repositorios arquivados ficam de fora.
        </p>
      </div>
      <a href={links.github} target="_blank" rel="noopener" class="botao">
        <Icone nome="github" tamanho={16} /> Ver perfil completo
      </a>
    </div>

    {
      linguagens.length > 0 && (
        <div class="filtros" role="group" aria-label="Filtrar projetos por linguagem">
          <button type="button" class="filtro filtro--ativo" data-filtro="todas">
            Todas <span class="filtro__n">{repos.length}</span>
          </button>
          {linguagens.map((l) => (
            <button type="button" class="filtro" data-filtro={l.nome}>
              {l.nome} <span class="filtro__n">{l.total}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      ordenados.length > 0 ? (
        <div class="grade" id="grade-projetos">
          {ordenados.map((repo) => (
            <CartaoProjeto repo={repo} descricao={descricaoCustom.get(repo.nome.toLowerCase())} />
          ))}
        </div>
      ) : (
        <div class="cartao vazio">
          <p>
            A API do GitHub nao respondeu durante a geracao desta pagina (normalmente e limite de
            requisicoes). Ela se resolve sozinha no proximo build automatico.
          </p>
          <a href={links.github} class="link-acento" target="_blank" rel="noopener">
            Ver os repositorios no GitHub <Icone nome="seta" tamanho={16} />
          </a>
        </div>
      )
    }

    <p class="sinc mono fraco" id="sinc" hidden>
      <span class="sinc__ponto"></span>
      <span id="sinc-texto"></span>
    </p>
  </section>
</Base>

<script is:inline define:vars={{ usuario: githubUser }}>
  // ----------------------------------------------------------
  // 1. Filtro por linguagem (puro CSS via atributo data-)
  // ----------------------------------------------------------
  const botoes = document.querySelectorAll('.filtro');
  const cartoes = document.querySelectorAll('#grade-projetos [data-repo]');

  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.filtro;
      botoes.forEach((b) => b.classList.toggle('filtro--ativo', b === botao));
      cartoes.forEach((c) => {
        const mostra = alvo === 'todas' || c.dataset.linguagem === alvo;
        c.style.display = mostra ? '' : 'none';
      });
    });
  });

  // ----------------------------------------------------------
  // 2. Sincronizacao ao vivo com o GitHub
  //    O HTML ja vem com os dados do ultimo build. Aqui a gente
  //    consulta a API de novo no navegador e corrige estrelas,
  //    forks e data de push que tenham mudado desde entao.
  //    Se falhar (rate limit, offline), nao acontece nada e o
  //    visitante continua vendo os dados do build.
  // ----------------------------------------------------------
  const fmt = new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

  async function sincronizar() {
    const url =
      'https://api.github.com/users/' + usuario + '/repos?per_page=100&sort=updated&type=owner';
    const resposta = await fetch(url, {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (!resposta.ok) throw new Error('HTTP ' + resposta.status);
    const dados = await resposta.json();

    const porNome = new Map(dados.map((r) => [r.name.toLowerCase(), r]));
    let alterados = 0;

    cartoes.forEach((cartao) => {
      const dado = porNome.get(cartao.dataset.repo.toLowerCase());
      if (!dado) return;

      const campos = [
        ['estrelas', dado.stargazers_count],
        ['forks', dado.forks_count],
      ];

      for (const [campo, valor] of campos) {
        const alvo = cartao.querySelector('[data-valor="' + campo + '"]');
        const bloco = cartao.querySelector('[data-campo="' + campo + '"]');
        if (!alvo || !bloco) continue;
        if (alvo.textContent.trim() !== String(valor)) alterados++;
        alvo.textContent = String(valor);
        bloco.hidden = valor === 0;
      }

      const dataAlvo = cartao.querySelector('[data-valor="atualizado"]');
      const iso = dado.pushed_at || dado.updated_at;
      if (dataAlvo && iso) {
        const texto = fmt.format(new Date(iso));
        if (dataAlvo.textContent.trim() !== texto) alterados++;
        dataAlvo.textContent = texto;
      }
    });

    // Repositorios criados depois do ultimo build ainda nao tem card.
    const conhecidos = new Set([...cartoes].map((c) => c.dataset.repo.toLowerCase()));
    const novos = dados.filter(
      (r) => !r.fork && !r.archived && !conhecidos.has(r.name.toLowerCase()),
    ).length;

    return { alterados, novos };
  }

  const aviso = document.getElementById('sinc');
  const texto = document.getElementById('sinc-texto');

  sincronizar()
    .then(({ alterados, novos }) => {
      if (!aviso || !texto) return;
      if (novos > 0) {
        texto.textContent =
          novos + (novos === 1 ? ' repositorio novo' : ' repositorios novos') +
          ' no GitHub — entram aqui no proximo build automatico.';
      } else if (alterados > 0) {
        texto.textContent = 'Dados atualizados agora a partir do GitHub.';
      } else {
        texto.textContent = 'Em dia com o GitHub.';
      }
      aviso.hidden = false;
    })
    .catch(() => {
      /* silencio proposital: o visitante ja tem os dados do build */
    });
</script>

<style>
  .titulo-pagina {
    font-size: var(--t-3xl);
    margin-bottom: 0.75rem;
  }

  .descricao-pagina {
    max-width: 40rem;
    font-size: var(--t-sm);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .filtro {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--texto-suave);
    font-size: var(--t-sm);
    transition: all var(--transicao);
  }
  .filtro:hover {
    border-color: var(--border-forte);
    color: var(--texto);
  }
  .filtro--ativo {
    background: var(--acento-suave);
    border-color: color-mix(in srgb, var(--acento) 45%, transparent);
    color: var(--acento);
  }

  .filtro__n {
    font-family: var(--fonte-mono);
    font-size: var(--t-xs);
    opacity: 0.7;
  }

  .vazio {
    gap: 1rem;
    align-items: flex-start;
  }

  .sinc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: var(--t-xs);
  }
  .sinc[hidden] { display: none; }

  .sinc__ponto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acento);
    box-shadow: 0 0 0 3px var(--acento-suave);
    flex-shrink: 0;
  }
</style>

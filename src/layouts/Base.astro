---
import { site, links } from '../site.config';
import Rail from '../components/Rail.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description = site.description, type = 'website', publishedAt } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name}, ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,400..600;1,7..72,400&family=Martian+Mono:wdth,wght@112.5,500;112.5,600&display=swap"
      rel="stylesheet"
    />

    <!-- Applies the saved theme before first paint, so the page never flashes. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {
          /* private mode blocks storage — stay on the light default */
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <div class="frame">
      <Rail />

      <div class="column">
        <main id="main" class="content">
          <slot />
        </main>

        <footer class="colophon">
          <p class="datum">
            © {year} {site.name} — set in Martian Mono, Literata and IBM Plex Mono. Built with
            Astro, published from
            <a href={links.github + '/Gustavo-Oliveira7.github.io'} class="colophon__link"
              >the repository</a
            >.
          </p>
        </footer>
      </div>
    </div>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const goingDark = root.getAttribute('data-theme') !== 'dark';
        if (goingDark) root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        try {
          localStorage.setItem('theme', goingDark ? 'dark' : 'light');
        } catch (e) {
          /* no persistence available; the choice lasts for this tab */
        }
      });
    </script>
  </body>
</html>

<style>
  .column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .colophon {
    min-width: 0;
    margin-top: auto;
    padding: 2rem var(--pad-x) 2.25rem;
    border-top: 1px solid var(--rule);
    max-width: 62rem;
  }

  .colophon__link {
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule-2);
    transition: color var(--ease), border-color var(--ease);
  }
  .colophon__link:hover {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }
</style>
